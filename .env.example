# Optional, for advanced users. Most people never need this file:
# `tgkit setup` saves your codes for you.
#
# To use it: copy it to a file named .env inside your Telegram Assistant data folder
# (`tgkit where` shows the folder), or set these as environment variables.
# Never share or commit the filled-in file.
TG_API_ID=
TG_API_HASH=
# Attachments bigger than this (MB) are noted but not downloaded.
TG_MAX_MEDIA_MB=50
